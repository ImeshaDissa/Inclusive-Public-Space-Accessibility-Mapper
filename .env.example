# Supabase Backend Configuration
# Copy this file to `.env` and fill in real values from your Supabase project:
#   Dashboard -> Project Settings -> API  (or: supabase projects api-keys --project-ref <ref> --experimental)
#
# EXPO_PUBLIC_SUPABASE_URL       : https://<PROJECT-REF>.supabase.co  (no trailing slash)
# EXPO_PUBLIC_SUPABASE_ANON_KEY  : the publishable key, e.g. sb_publishable_... (or the legacy anon JWT)
#                                  NOTE: no space after `=` — `KEY= value` breaks some tooling.
#
# Sanity-check a clone before running the app (both must return 200):
#   curl -s -o /dev/null -w "%{http_code}\n" "$EXPO_PUBLIC_SUPABASE_URL/auth/v1/health" -H "apikey: $EXPO_PUBLIC_SUPABASE_ANON_KEY"
#   curl -s -o /dev/null -w "%{http_code}\n" "$EXPO_PUBLIC_SUPABASE_URL/rest/v1/profiles?select=id&limit=1" -H "apikey: $EXPO_PUBLIC_SUPABASE_ANON_KEY"

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# AI assistant (Edge Function secret, NOT a client var)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=cohere/north-mini-code:free

# ---------------------------------------------------------------------------
# Email (Tier 3) — these are Supabase Edge Function secrets, NOT client env
# vars. Set them on the project and (re)deploy the functions:
#
#   supabase functions deploy send-email push-notify
#   supabase secrets set BREVO_API_KEY=xkeysib-... EMAIL_FROM=you@verified.com EMAIL_SENDER_NAME=InclusiveMapper
#
# BREVO_API_KEY    : Brevo REST key (xkeysib-...), app.brevo.com -> SMTP & API -> API Keys
#                    (an SMTP key 'xsmtpsib-...' will be rejected by the function)
# EMAIL_FROM       : verified sender (app.brevo.com -> Senders & IP)
# EMAIL_SENDER_NAME: optional display name (default InclusiveMapper)
#
# The database schema (tables, RLS, triggers, seed data) is applied with:
#
#   supabase db push          # runs supabase/migrations/*.sql against the linked project
#
# Verify the schema is present:
#   curl -s "$EXPO_PUBLIC_SUPABASE_URL/rest/v1/profiles?select=id&limit=1" -H "apikey: $EXPO_PUBLIC_SUPABASE_ANON_KEY"
# ---------------------------------------------------------------------------
