# Supabase Backend Configuration
# Replace with your actual Supabase project URL and Anon Key from your Supabase Dashboard:
# Dashboard -> Project Settings -> API

EXPO_PUBLIC_SUPABASE_URL=url
EXPO_PUBLIC_SUPABASE_ANON_KEY= public key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=cohere/north-mini-code:free
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=verified-sender@example.com

# ---------------------------------------------------------------------------
# Email (Tier 3) — NOT client env vars. Set these as Supabase Edge Function
# secrets, then deploy the functions:
#
#   supabase functions deploy send-email push-notify
#   supabase secrets set BREVO_API_KEY=xkeysib-... EMAIL_FROM=you@verified.com
#
# BREVO_API_KEY : Brevo REST key (xkeysib-...), app.brevo.com -> SMTP & API -> API Keys
# EMAIL_FROM    : verified sender (app.brevo.com -> Senders & IP)
# EMAIL_SENDER_NAME : optional display name (default InclusiveMapper)
#
# Also run supabase/migration_notifications.sql in the SQL Editor (adds
# notifications INSERT/DELETE RLS + email_requests table).
# ---------------------------------------------------------------------------
